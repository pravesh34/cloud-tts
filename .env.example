# Copy to .env for local development. Never commit .env.
USER_API_KEY=dev-user-key
WORKER_TOKEN=dev-worker-token

# Local SQLite file (Render uses /tmp, which is ephemeral by design)
DATABASE_PATH=./.data/gateway.sqlite3

# Worker is considered offline after this many seconds without a heartbeat
HEARTBEAT_TTL=60

# Delete completed/failed jobs (and their audio) after this many seconds
JOB_TTL_SECONDS=2700

# Requeue jobs stuck in "processing" after this many seconds
STALE_PROCESSING_SECONDS=300

# Reject uploads larger than this
MAX_AUDIO_MB=25

# Comma separated, or * for any origin
CORS_ORIGINS=*
